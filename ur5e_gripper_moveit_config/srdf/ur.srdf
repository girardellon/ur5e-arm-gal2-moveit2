<?xml version="1.0" encoding="UTF-8"?>
<robot name="ur">

  <group name="ur_manipulator">
    <chain base_link="world" tip_link="tool0"/>
  </group>

  <group name="gripper">
    <joint name="gr_b_to_l1"/>
  </group>

  <group name="ur_with_gripper">
    <group name="ur_manipulator"/>
    <group name="gripper"/>
  </group>

  <end_effector name="gripper_ee" parent_link="tool0" group="gripper"/>

  <!-- Allow collisions between adjacent arm links (needed with many collision meshes) -->
  <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>

  <!-- Allow collisions between wrist and gripper base (adjacent) -->
  <disable_collisions link1="wrist_3_link" link2="gr_base_link" reason="Adjacent"/>

  <!-- Allow internal adjacent collisions in the gripper (these show up in your validity output) -->
  <disable_collisions link1="gr_base_link" link2="gr_coupler1" reason="Adjacent"/>
  <disable_collisions link1="gr_base_link" link2="gr_coupler2" reason="Adjacent"/>
  <disable_collisions link1="gr_base_link" link2="gr_link1" reason="Adjacent"/>
  <disable_collisions link1="gr_base_link" link2="gr_link2" reason="Adjacent"/>
  <disable_collisions link1="gr_coupler1" link2="gr_finger1" reason="Adjacent"/>
  <disable_collisions link1="gr_coupler2" link2="gr_finger2" reason="Adjacent"/>
  <disable_collisions link1="gr_finger1" link2="gr_link1" reason="Adjacent"/>
  <disable_collisions link1="gr_finger2" link2="gr_link2" reason="Adjacent"/>

</robot>
